{
  "name": "@usescherie/archer",
  "version": "0.1.0",
  "description": "Architecture tests for TypeScript and JavaScript projects",
  "keywords": [
    "architecture",
    "architecture-testing",
    "archunit",
    "boundaries",
    "bun",
    "dependency-rules",
    "javascript",
    "jest",
    "monorepo",
    "typescript",
    "vitest"
  ],
  "homepage": "https://github.com/usescherie/archer#readme",
  "bugs": {
    "url": "https://github.com/usescherie/archer/issues"
  },
  "license": "UNLICENSED",
  "author": "Lucas Coutinho",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/usescherie/archer.git"
  },
  "bin": {
    "archer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bun/plugin.*",
    "./dist/jest/plugin.*",
    "./dist/vitest/plugin.*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vitest": [
        "dist/vitest.d.ts"
      ],
      "vitest/plugin": [
        "dist/vitest/plugin.d.ts"
      ],
      "jest": [
        "dist/jest.d.ts"
      ],
      "jest/plugin": [
        "dist/jest/plugin.d.ts"
      ],
      "bun": [
        "dist/bun.d.ts"
      ],
      "bun/plugin": [
        "dist/bun/plugin.d.ts"
      ],
      "node": [
        "dist/node.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./vitest/plugin": {
      "import": {
        "types": "./dist/vitest/plugin.d.ts",
        "default": "./dist/vitest/plugin.js"
      },
      "require": {
        "types": "./dist/vitest/plugin.d.cts",
        "default": "./dist/vitest/plugin.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./jest/plugin": {
      "import": {
        "types": "./dist/jest/plugin.d.ts",
        "default": "./dist/jest/plugin.js"
      },
      "require": {
        "types": "./dist/jest/plugin.d.cts",
        "default": "./dist/jest/plugin.cjs"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/bun.d.ts",
        "default": "./dist/bun.js"
      },
      "require": {
        "types": "./dist/bun.d.cts",
        "default": "./dist/bun.cjs"
      }
    },
    "./bun/plugin": {
      "import": {
        "types": "./dist/bun/plugin.d.ts",
        "default": "./dist/bun/plugin.js"
      },
      "require": {
        "types": "./dist/bun/plugin.d.cts",
        "default": "./dist/bun/plugin.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run test:adapters && npm run build",
    "check:package": "npm run build && publint && attw --pack .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "npm run check",
    "release:check": "npm run check && npm run check:package && npm audit --omit=dev && npm pack --dry-run",
    "test": "vitest run",
    "test:adapters": "npm run build && npm run test:jest && npm run test:node && npm run test:bun && npm run test:cli && npm run test:dogfood",
    "test:bun": "bun test test/runners/bun-adapter.test.mjs",
    "test:cli": "node dist/cli.js check --config test/fixtures/cli/archer.config.mjs --reporter agent",
    "test:dogfood": "node dist/cli.js check --config archer.config.ts",
    "test:jest": "jest --runInBand --runTestsByPath test/runners/jest-adapter.test.cjs",
    "test:node": "node --test test/runners/node-adapter.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "jiti": "^2.7.0",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@jest/globals": "^30.4.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.2",
    "jest": "^30.4.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@jest/globals": ">=29.0.0 <31.0.0",
    "typescript": ">=5.7.0 <7.0.0",
    "vitest": ">=3.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
