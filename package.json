{
  "name": "@lucasacoutinho/archer",
  "version": "0.3.0",
  "description": "Architecture tests for TypeScript and JavaScript projects",
  "keywords": [
    "architecture",
    "architecture-testing",
    "boundaries",
    "dependency-rules",
    "typescript"
  ],
  "homepage": "https://github.com/lucasacoutinho/archer#readme",
  "bugs": {
    "url": "https://github.com/lucasacoutinho/archer/issues"
  },
  "license": "Apache-2.0",
  "author": "Lucas Coutinho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasacoutinho/archer.git"
  },
  "type": "module",
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    }
  },
  "bin": {
    "archer": "dist/cli/main.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && sh scripts/check-declarations.sh",
    "test": "vitest run",
    "smoke:bun": "bun scripts/bun-smoke.mjs",
    "lean": "sh scripts/lean-audit.sh",
    "check": "npm run lean && npm run typecheck && npm test && npm run build && npm run dogfood",
    "dogfood": "node dist/cli/main.js check"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "effect": "4.0.6",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.57.0",
    "@effect/vitest": "4.0.6",
    "@types/node": "22.20.5",
    "vitest": "5.0.5"
  }
}
