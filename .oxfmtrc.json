{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist/**", "package-lock.json", "test/fixtures/**"],
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": true,
  "sortImports": {
    "newlinesBetween": false,
    "partitionByNewline": true
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "trailingComma": "all"
}
